# 复制为 .env 后按需填写。
# 若不配置任何密钥：开发服务器会返回内置演示代码（页面会提示「离线演示」）。
# 若希望「未配置密钥则直接报错」，设置 DISABLE_AI_MOCK=1

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# OpenAI — https://platform.openai.com/
OPENAI_API_KEY=

# 阿里云 DashScope（通义千问 OpenAI 兼容）— https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# DISABLE_AI_MOCK=1
# 关闭 Function Calling（仅用 fenced 文本，不附带 tools 字段）
# DISABLE_FUNCTION_CALLING=1
